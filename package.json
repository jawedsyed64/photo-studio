{
  "name": "photo-studio",
  "productName": "Photo Studio",
  "version": "0.3.0",
  "description": "Professional photo editing studio for Windows - GPU editing, colour tools, presets and AI (background removal, object removal, upscaling, styles)",
  "author": "jawedsyed64",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && electron .",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build && electron-builder --win nsis portable --publish never",
    "ai-selftest": "node scripts/ai-selftest.cjs ai-models"
  },
  "dependencies": {
    "onnxruntime-node": "^1.20.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0"
  },
  "build": {
    "appId": "com.jawedsyed64.photostudio",
    "productName": "Photo Studio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/renderer/**/*",
      "!dist/renderer/*.map",
      "build/icon.png",
      "package.json",
      "!node_modules/onnxruntime-node/bin/napi-v*/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v*/darwin/**"
    ],
    "fileAssociations": [
      {
        "ext": "pstudio",
        "name": "Photo Studio Project",
        "description": "Photo Studio project",
        "role": "Editor"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Photo Studio",
      "artifactName": "PhotoStudio-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "PhotoStudio-Portable-${version}.${ext}"
    },
    "asarUnpack": [
      "node_modules/onnxruntime-node/**"
    ]
  }
}
